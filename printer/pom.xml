<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.makan1869.capabilitymesh</groupId>
        <artifactId>capability-mesh</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>printer</artifactId>
    <packaging>jar</packaging>

    <name>printer</name>
    <description>Discovers MCP servers from mcp-registry at startup, builds a dynamic MCP client per server, and asks an Anthropic model (via Spring AI) to "Print ABC" using the discovered tools</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <dependency>
            <!-- Spring Boot 4.1 moved RestClientAutoConfiguration (the RestClient.Builder
                 bean) out of plain spring-web into this dedicated module. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
